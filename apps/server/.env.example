# ===== 应用基础配置 =====
NODE_ENV=development
PORT=3000
# 全局接口前缀
API_PREFIX=api/v1

# ===== 数据库配置 =====
# 默认使用 better-sqlite3（免本地编译）；如需切换 postgres/mysql，请修改 DB_TYPE 并补充对应连接信息
DB_TYPE=better-sqlite3
DB_DATABASE=./sso.sqlite

# ===== JWT 配置 =====
# 生产环境请务必替换为足够长且随机的密钥
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# Access Token 过期时间（短过期）
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token 过期时间（长过期）
JWT_REFRESH_EXPIRES_IN=7d

# ===== Cookie 配置 =====
# 生产环境（HTTPS）设为 true
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ===== 全局会话配置 =====
# 全局会话有效期（毫秒），默认 1 天
SESSION_TTL_MS=86400000

# ===== Ticket 临时票据配置 =====
# 票据有效期（毫秒），一次一用，默认 60 秒
TICKET_TTL_MS=60000

# ===== OAuth 2.0 / OIDC 配置 =====
# Issuer 标识（用于 id_token 的 iss claim，生产环境需改为实际域名）
ISSUER=http://localhost:3000
# Authorization Code 有效期（毫秒），默认 60 秒
AUTHORIZATION_CODE_TTL_MS=60000
# ID Token 有效期
ID_TOKEN_EXPIRES_IN=1h
